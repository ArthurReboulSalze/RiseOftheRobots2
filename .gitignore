# Dépôt de code uniquement : tout nouveau dossier racine est privé par défaut.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/IMPORTER.cmd
!/TOOLS/
/TOOLS/*
!/TOOLS/*.py
# Ancien générateur ponctuel, qui réécrit main.cpp ; conservé uniquement en local.
/TOOLS/wire_combat.py
!/TOOLS/templates/
/TOOLS/templates/*
!/TOOLS/templates/*.html
!/TOOLS/tests/
/TOOLS/tests/*
!/TOOLS/tests/*.py
!/TOOLS/ghidra_scripts/
/TOOLS/ghidra_scripts/*
!/TOOLS/ghidra_scripts/*.py
!/PORT/
/PORT/*
!/PORT/CMakeLists.txt
!/PORT/src/
/PORT/src/*
!/PORT/src/*.cpp
!/PORT/src/*.h
!/PORT/tests/
/PORT/tests/*
!/PORT/tests/*.cpp
!/documentation/
/documentation/*
!/documentation/*.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
**/__pycache__/
*.pyc

# Toujours privés, même si une règle est assouplie plus haut.
/SRC/
/EXTRACTED/
/LOCAL/
/ANALYSIS/
/Ghidra_Project/
/capture/
/documentation/captures/
/PORT/build/
/PORT/thirdparty/
/.venv/
