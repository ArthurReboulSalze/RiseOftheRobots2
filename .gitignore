# Code-only repository: any new top-level directory is private by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/requirements.txt
!/IMPORTER.cmd
!/TOOLS/
/TOOLS/*
!/TOOLS/*.py
# One-off legacy generator that rewrites main.cpp; keep it local only.
/TOOLS/wire_combat.py
!/TOOLS/templates/
/TOOLS/templates/*
!/TOOLS/templates/*.html
!/TOOLS/tests/
/TOOLS/tests/*
!/TOOLS/tests/*.py
!/TOOLS/ghidra_scripts/
/TOOLS/ghidra_scripts/*
!/TOOLS/ghidra_scripts/*.py
!/PORT/
/PORT/*
!/PORT/CMakeLists.txt
!/PORT/src/
/PORT/src/*
!/PORT/src/*.cpp
!/PORT/src/*.h
!/PORT/tests/
/PORT/tests/*
!/PORT/tests/*.cpp
!/documentation/
/documentation/*
!/documentation/*.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
**/__pycache__/
*.pyc

# Always private, even if an allowlist rule above changes.
/SRC/
/EXTRACTED/
/LOCAL/
/ANALYSIS/
/Ghidra_Project/
/capture/
/documentation/captures/
/PORT/build/
/PORT/thirdparty/
/.venv/
